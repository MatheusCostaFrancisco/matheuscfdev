{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "src/**",
      "public/**",
      "index.html",
      "404.html",
      "en/**",
      "pt/**",
      "package.json",
      "yarn.lock",
      "vite.config.ts",
      ".env.production",
      "tsconfig*.json",
      "railway.json",
      "Caddyfile"
    ]
  }
}
