# Static server for Railway (ADR 0006). Railpack uses this file instead of its
# default SPA Caddyfile and runs `caddy run --config /Caddyfile`; the Vite build
# is copied to /app/dist.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8 # Railway's proxy
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	root * /app/dist

	encode zstd gzip

	# Vite emits /assets/* with a content hash in the name. /fonts/* is not
	# hashed: a changed font gets a new file name (ADR 0006).
	@immutable path /assets/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# HTML and the other unhashed files revalidate on every visit, so a deploy
	# shows up on the next page load.
	@revalidate not path /assets/* /fonts/*
	header @revalidate Cache-Control "no-cache"

	# Old roadmap URLs move permanently to the journey (ADR 0008). Path matching
	# is case-insensitive; the query string is kept and the browser keeps the
	# #fragment across the redirect.
	@roadmapEn path /en/roadmap /en/roadmap/ /en/roadmap/index.html
	redir @roadmapEn /en/journey/{?query} 301

	@roadmapPt path /pt/roadmap /pt/roadmap/ /pt/roadmap/index.html
	redir @roadmapPt /pt/jornada/{?query} 301

	# No SPA fallback: every page is its own HTML file (ADR 0005). A path with
	# no file answers 404 with the body of 404.html.
	file_server {
		hide .git .env*
	}

	handle_errors 404 {
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}
}
